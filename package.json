{
  "name": "erp-financ",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "start": "cross-env NODE_ENV=production node build/server.cjs",
    "lint": "tsc --noEmit",
    "teste": "tsx server/calculo.test.ts && tsx server/rateio.test.ts && tsx server/sugestoes.test.ts && tsx server/mensagens.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@vercel/blob": "^2.9.0",
    "@vitejs/plugin-react": "^5.2.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "decimal.js": "^10.4.3",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "iron-session": "^8.0.4",
    "lucide-react": "^0.553.0",
    "mysql2": "^3.22.1",
    "nodemailer": "^10.4.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.18.5",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.23.15",
    "vite": "^6.4.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
