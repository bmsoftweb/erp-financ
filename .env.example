# MySQL do ERP (bmerp_000000)
MYSQL_HOST=""
MYSQL_PORT="3306"
MYSQL_USER=""
MYSQL_PASSWORD=""
MYSQL_DATABASE="bmerp_000000"
ID_EMPRESA="1"

# Sessão (mínimo 32 caracteres)
SESSION_SECRET=""

# Endereço do ERP-Master, para onde /api/entrar volta em caso de erro (vírgula separa vários)
MASTER_URL=""

# Chave para erp-vendas/erp-compras chamarem a API do financeiro (Authorization: Bearer ...; mínimo 32 caracteres)
FINANC_CHAVE_API=""

# Anexos dos títulos (Vercel Blob): Vercel › Storage › Blob ligado ao projeto cria esta variável
BLOB_READ_WRITE_TOKEN=""

# Conciliação, boleto e Pix: BMBancos (erp-bancos). BANCOS_SECRET = o SESSION_SECRET do BMBancos (mínimo 32 caracteres)
BANCOS_URL=""
BANCOS_SECRET=""
# Webhook POST /api/financ/webhooks/bancos: X-Assinatura = sha256=<HMAC-SHA256 do corpo com este segredo> (mínimo 32)
FINANC_WEBHOOK_SECRET=""

# Régua de cobrança (fase 4)
# Agendador: a Vercel chama GET /api/financ/cron/cobranca a cada 15 min com Authorization: Bearer CRON_SECRET (mínimo 16)
CRON_SECRET=""
# Local: 1 liga a rodada a cada 15 min no próprio servidor (deixe desligado no desenvolvimento)
COBRANCA_AUTOMATICA=""
# 1 = não envia nada de verdade (id falso), para testar a régua
COBRANCA_SIMULAR=""
# Endereço público do app, para o {{link}} do boleto nas mensagens (ex.: https://financ.bmsoft.com.br)
FINANC_URL_PUBLICA=""
# WhatsApp Cloud API (Meta): token permanente do usuário do sistema e o id do número
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_CLOUD_PHONE_ID=""
# Webhook GET/POST /api/financ/webhooks/mensagens: token de verificação escolhido no painel da Meta e o App Secret
WHATSAPP_CLOUD_VERIFY_TOKEN=""
WHATSAPP_CLOUD_APP_SECRET=""
